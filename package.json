{
  "name": "valence-push-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "oxfmt src",
    "lint": "oxlint --deny-warnings --type-aware src",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.7",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
